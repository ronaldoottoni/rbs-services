// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id       String     @id @default(cuid())
  tipo     PessoaTipo
  cpfCnpj  String?
  nome     String
  telefone String?
  email    String?
  cidade   String?
  estado   String?
  ativo    Boolean    @default(true)

  propriedades  Propriedade[]
  projetos      Projeto[]
  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]   @relation("FornecedorContaPagar")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PessoaTipo {
  CLIENTE
  FORNECEDOR
  FUNCIONARIO
  TRANSPORTADORA
  BANCO
}

model Propriedade {
  id          String          @id @default(cuid())
  clienteId   String
  nome        String
  tipo        PropriedadeTipo
  matricula   String?
  areaTotalHa Float?
  cidade      String?
  estado      String?
  endereco    String?
  latitude    Float?
  longitude   Float?
  ativo       Boolean         @default(true)

  cliente  Pessoa            @relation(fields: [clienteId], references: [id])
  areas    AreaPropriedade[]
  projetos Projeto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PropriedadeTipo {
  FAZENDA
  SITIO
  CHACARA
  OUTRO
}

model AreaPropriedade {
  id                 String   @id @default(cuid())
  propriedadeId      String
  nome               String
  tipo               AreaTipo
  areaHa             Float?
  culturaAtual       String?
  descricao          String?
  latitudeCentro     Float?
  longitudeCentro    Float?
  coordenadasGeoJson Json?
  ativo              Boolean  @default(true)

  propriedade  Propriedade   @relation(fields: [propriedadeId], references: [id])
  projetosArea ProjetoArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AreaTipo {
  CULTIVO
  PASTAGEM
  RESERVA
  APP
  SEDE
  ESTRADA
  AGUA
  OUTRO
}

model ServicoCatalogo {
  id          String         @id @default(cuid())
  nome        String
  tipo        ServicoTipo
  descricao   String?
  valorPadrao Float?
  unidade     ServicoUnidade
  ativo       Boolean        @default(true)

  projetos Projeto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ServicoTipo {
  DRONE
  AMBIENTAL
  IRRIGACAO
  CONSULTORIA
  OUTRO
}

enum ServicoUnidade {
  HECTARE
  HORA
  DIARIA
  PROJETO
  UNIDADE
}

model Projeto {
  id String @id @default(cuid())

  clienteId         String
  propriedadeId     String?
  servicoCatalogoId String?

  nome          String
  tipo          ProjetoTipo
  descricao     String?
  dataInicio    DateTime?
  dataFim       DateTime?
  status        ProjetoStatus @default(PLANEJAMENTO)
  valorPrevisto Float?
  valorFechado  Float?
  ativo         Boolean       @default(true)

  cliente         Pessoa           @relation(fields: [clienteId], references: [id])
  propriedade     Propriedade?     @relation(fields: [propriedadeId], references: [id])
  servicoCatalogo ServicoCatalogo? @relation(fields: [servicoCatalogoId], references: [id])
  areas           ProjetoArea[]
  contasReceber   ContaReceber[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  contaPagars ContaPagar[]
}

model ProjetoArea {
  id                String  @id @default(cuid())
  projetoId         String
  areaPropriedadeId String
  observacoes       String?

  projeto         Projeto         @relation(fields: [projetoId], references: [id])
  areaPropriedade AreaPropriedade @relation(fields: [areaPropriedadeId], references: [id])

  execucoes ServicoExecutado[]

  createdAt DateTime @default(now())

  @@unique([projetoId, areaPropriedadeId])
}

enum ProjetoTipo {
  DRONE
  AMBIENTAL
  IRRIGACAO
  CONSULTORIA
  OUTRO
}

enum ProjetoStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

model ServicoExecutado {
  id String @id @default(cuid())

  projetoAreaId String

  dataExecucao DateTime

  areaExecutadaHa Float?

  produtoAplicado String?
  doseAplicada    String?

  valorExecutado Decimal @db.Decimal(15, 2)

  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projetoArea   ProjetoArea    @relation(fields: [projetoAreaId], references: [id])
  contasReceber ContaReceber[]
}

model ContaReceber {
  id String @id @default(cuid())

  clienteId          String
  projetoId          String?
  servicoExecutadoId String?

  numeroDocumento String?
  descricao       String
  competencia     DateTime?
  dataEmissao     DateTime
  dataVencimento  DateTime
  valorOriginal   Decimal          @db.Decimal(15, 2)
  valorDesconto   Decimal          @default(0) @db.Decimal(15, 2)
  valorJuros      Decimal          @default(0) @db.Decimal(15, 2)
  valorMulta      Decimal          @default(0) @db.Decimal(15, 2)
  valorRecebido   Decimal          @default(0) @db.Decimal(15, 2)
  valorAberto     Decimal          @default(0) @db.Decimal(15, 2)
  status          FinanceiroStatus @default(ABERTO)
  formaPagamento  FormaPagamento?  @default(PIX)
  observacoes     String?
  ativo           Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente          Pessoa            @relation(fields: [clienteId], references: [id])
  projeto          Projeto?          @relation(fields: [projetoId], references: [id])
  servicoExecutado ServicoExecutado? @relation(fields: [servicoExecutadoId], references: [id])

  recebimento Recebimento[]
}

enum FinanceiroStatus {
  ABERTO
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  VENCIDO
  CANCELADO
  RENEGOCIADO
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  BOLETO
  CHEQUE
  OUTROS
}

model Recebimento {
  id             String @id @default(cuid())
  contaReceberId String

  dataRecebimento  DateTime
  valorRecebido    Decimal        @db.Decimal(15, 2)
  valorJuros       Decimal        @default(0) @db.Decimal(15, 2)
  valorMulta       Decimal        @default(0) @db.Decimal(15, 2)
  valorDesconto    Decimal        @default(0) @db.Decimal(15, 2)
  formaRecebimento FormaPagamento
  contaBancoId     String?
  comprovanteUrl   String?
  numeroReferencia String?
  observacoes      String?
  estornado        Boolean        @default(false)
  dataEstorno      DateTime?
  motivoEstorno    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contaReceber ContaReceber @relation(fields: [contaReceberId], references: [id])
}

model ContaPagar {
  id String @id @default(cuid())

  fornecedorId    String
  projetoId       String?
  numeroDocumento String?
  descricao       String
  competencia     DateTime?
  dataEmissao     DateTime
  dataVencimento  DateTime

  valorOriginal Decimal @db.Decimal(15, 2)
  valorDesconto Decimal @db.Decimal(15, 2)
  valorJuros    Decimal @db.Decimal(15, 2)
  valorMulta    Decimal @db.Decimal(15, 2)
  valorPago     Decimal @db.Decimal(15, 2)
  valorAberto   Decimal @db.Decimal(15, 2)

  status         FinanceiroStatus  @default(ABERTO)
  formaPagamento FormaPagamento?
  categoria      CategoriaDespesa?
  observacoes    String?
  ativo          Boolean           @default(true)

  fornecedor Pessoa      @relation("FornecedorContaPagar", fields: [fornecedorId], references: [id])
  projeto    Projeto?    @relation(fields: [projetoId], references: [id])
  pagamento  Pagamento[]
}

enum CategoriaDespesa {
  INSUMO
  COMBUSTIVEL
  MANUTENCAO
  EQUIPAMENTO
  SERVICO_TERCEIRO
  IMPOSTO
  TRANSPORTE
  ADMINISTRATIVO
  OUTROS
}

model Pagamento {
  id           String @id @default(cuid())
  contaPagarId String

  dataPagamento    DateTime
  valorRecebido    Decimal        @db.Decimal(15, 2)
  valorJuros       Decimal        @default(0) @db.Decimal(15, 2)
  valorMulta       Decimal        @default(0) @db.Decimal(15, 2)
  valorDesconto    Decimal        @default(0) @db.Decimal(15, 2)
  formaPagamento   FormaPagamento
  contaBancoId     String?
  comprovanteUrl   String?
  numeroReferencia String?
  observacoes      String?
  estornado        Boolean        @default(false)
  dataEstorno      DateTime?
  motivoEstorno    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contaPagar ContaPagar @relation(fields: [contaPagarId], references: [id])
}
