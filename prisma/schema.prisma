// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id        String   @id @default(cuid())
  tipo      PessoaTipo
  cpfCnpj   String?
  nome      String
  telefone  String?
  email     String?
  cidade    String?
  estado    String?
  ativo     Boolean  @default(true)

  propriedades Propriedade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PessoaTipo {
  CLIENTE
  FORNECEDOR
  FUNCIONARIO
  TRANSPORTADORA
  BANCO
}

model Propriedade {
  id             String   @id @default(cuid())
  clienteId      String
  nome           String
  tipo           propriedade_tipo
  matricula      String?
  areaTotalHa    Float?
  cidade         String?
  estado         String?
  endereco       String?
  latitude       Float?
  longitude      Float?
  ativo          Boolean @default(true)

  cliente     Pessoa           @relation(fields: [clienteId], references: [id])
  areas AreaPropriedade[]

  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())
}

enum propriedade_tipo{
  FAZENDA
  SITIO
  CHACARA
  OUTRO
}

model AreaPropriedade {
  id                 String            @id @default(cuid())
  propriedadeId      String
  nome               String
  tipo               AreaTipo
  areaHa             Float?
  culturaAtual       String?
  descricao          String?
  latitudeCentro     Float?
  longitudeCentro    Float?
  coordenadasGeoJson Json?
  ativo              Boolean           @default(true)

  propriedade        Propriedade       @relation(fields: [propriedadeId], references: [id])

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

enum AreaTipo {
  CULTIVO
  PASTAGEM
  RESERVA
  APP
  SEDE
  ESTRADA
  AGUA
  OUTRO
}

model ServicoCatalogo {
  id          String      @id @default(cuid())
  nome        String
  tipo        ServicoTipo
  descricao   String?
  valorPadrao Float?
  unidade     ServicoUnidade
  ativo       Boolean     @default(true)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum ServicoTipo {
  DRONE
  AMBIENTAL
  IRRIGACAO
  CONSULTORIA
  OUTRO
}

enum ServicoUnidade {
  HECTARE
  HORA
  DIARIA
  PROJETO
  UNIDADE
}