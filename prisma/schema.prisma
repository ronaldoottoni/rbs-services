// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id       String     @id @default(cuid())
  tipo     PessoaTipo
  cpfCnpj  String?
  nome     String
  telefone String?
  email    String?
  cidade   String?
  estado   String?
  ativo    Boolean    @default(true)

  propriedades Propriedade[]
  projetos     Projeto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PessoaTipo {
  CLIENTE
  FORNECEDOR
  FUNCIONARIO
  TRANSPORTADORA
  BANCO
}

model Propriedade {
  id          String           @id @default(cuid())
  clienteId   String
  nome        String
  tipo        propriedade_tipo
  matricula   String?
  areaTotalHa Float?
  cidade      String?
  estado      String?
  endereco    String?
  latitude    Float?
  longitude   Float?
  ativo       Boolean          @default(true)

  cliente  Pessoa            @relation(fields: [clienteId], references: [id])
  areas    AreaPropriedade[]
  projetos Projeto[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

enum propriedade_tipo {
  FAZENDA
  SITIO
  CHACARA
  OUTRO
}

model AreaPropriedade {
  id                 String   @id @default(cuid())
  propriedadeId      String
  nome               String
  tipo               AreaTipo
  areaHa             Float?
  culturaAtual       String?
  descricao          String?
  latitudeCentro     Float?
  longitudeCentro    Float?
  coordenadasGeoJson Json?
  ativo              Boolean  @default(true)

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id])
  projetos    Projeto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AreaTipo {
  CULTIVO
  PASTAGEM
  RESERVA
  APP
  SEDE
  ESTRADA
  AGUA
  OUTRO
}

model ServicoCatalogo {
  id          String         @id @default(cuid())
  nome        String
  tipo        ServicoTipo
  descricao   String?
  valorPadrao Float?
  unidade     ServicoUnidade
  ativo       Boolean        @default(true)

  projetos Projeto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ServicoTipo {
  DRONE
  AMBIENTAL
  IRRIGACAO
  CONSULTORIA
  OUTRO
}

enum ServicoUnidade {
  HECTARE
  HORA
  DIARIA
  PROJETO
  UNIDADE
}

model Projeto {
  id String @id @default(cuid())

  clienteId         String
  propriedadeId     String?
  areaPropriedadeId String?
  servicoCatalogoId String?

  nome      String
  tipo      ProjetoTipo
  descricao String?

  dataInicio DateTime?
  dataFim    DateTime?

  status ProjetoStatus @default(PLANEJAMENTO)

  valorPrevisto Float?
  valorFechado  Float?

  ativo Boolean @default(true)

  cliente Pessoa @relation(fields: [clienteId], references: [id])

  propriedade Propriedade? @relation(fields: [propriedadeId], references: [id])

  areaPropriedade AreaPropriedade? @relation(fields: [areaPropriedadeId], references: [id])

  servicoCatalogo ServicoCatalogo? @relation(fields: [servicoCatalogoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjetoTipo {
  DRONE
  AMBIENTAL
  IRRIGACAO
  CONSULTORIA
  OUTRO
}

enum ProjetoStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
  CANCELADO
}
